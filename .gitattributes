# Normalize line endings — repo is LF everywhere (Windows dev host included)
* text=auto eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries — never touch
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.wasm binary
*.node binary
*.exe binary
*.dll binary
*.dylib binary
*.so binary
